pipeline {
  agent any
  options { timestamps() }

  environment {
    AWS_REGION   = 'ap-south-1'
    ACCOUNT_ID   = '338320348680'
    ECR_BACKEND  = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/camp-travel-backend"
    ECR_FRONTEND = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/camp-travel-frontend"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build Images') {
      steps {
        sh '''
          set -eux
          docker build -t backend:local  -f backend/Dockerfile  .
          docker build -t frontend:local -f frontend/Dockerfile .
        '''
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') { // <-- must match Jenkins > System > SonarQube servers "Name"
          sh '''
            set -eux

            SETTINGS_FILE="sonar-project.properties"
            [ -f "$SETTINGS_FILE" ] || { echo "Missing $SETTINGS_FILE at repo root"; exit 1; }

            # Show settings for debug
            sed -n '1,200p' "$SETTINGS_FILE" || true

            docker run --rm \
              -e SONAR_HOST_URL="${SONAR_HOST_URL}" \
              -e SONAR_LOGIN="${SONAR_AUTH_TOKEN}" \
              -v "$WORKSPACE:/usr/src" \
              -w /usr/src \
              sonarsource/sonar-scanner-cli:5 \
                -Dproject.settings="$SETTINGS_FILE"
          '''
        }
      }
    }

    stage('Trivy image scan (soft-fail)') {
      steps {
        sh '''
          set +e
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --no-progress backend:local || true
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --no-progress frontend:local || true
          true
        '''
      }
    }

    stage('Login, tag & push to ECR') {
      steps {
        sh '''
          set -eux
          aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

          COMMIT=$(git rev-parse --short HEAD || echo manual)
          echo "$COMMIT" > COMMIT.sha
          echo "COMMIT=$COMMIT" > env.out

          docker tag backend:local  $ECR_BACKEND:latest
          docker tag backend:local  $ECR_BACKEND:$COMMIT
          docker tag frontend:local $ECR_FRONTEND:latest
          docker tag frontend:local $ECR_FRONTEND:$COMMIT

          docker push $ECR_BACKEND:$COMMIT
          docker push $ECR_BACKEND:latest
          docker push $ECR_FRONTEND:$COMMIT
          docker push $ECR_FRONTEND:latest
        '''
      }
    }

    stage('Deploy to EKS') {
      steps {
        sh '''
          set -eux
          # Build kubeconfig via IAM (requires eks:DescribeCluster on EC2 role)
          aws eks update-kubeconfig --region $AWS_REGION --name camp-travel-eks

          # Source COMMIT tag
          [ -f env.out ] && . ./env.out || true

          # Ensure namespace exists
          kubectl get ns camp-travel || kubectl create ns camp-travel

          # First-time apply or idempotent update
          kubectl -n camp-travel apply -f k8s/backend-deployment.yaml
          kubectl -n camp-travel apply -f k8s/frontend-deployment.yaml

          # Update images to the new tag
          kubectl -n camp-travel set image deploy/backend  backend=${ECR_BACKEND}:${COMMIT}
          kubectl -n camp-travel set image deploy/frontend frontend=${ECR_FRONTEND}:${COMMIT}

          kubectl -n camp-travel rollout status deploy/backend  --timeout=180s
          kubectl -n camp-travel rollout status deploy/frontend --timeout=180s
        '''
      }
    }

    stage('Smoke Test (Service LoadBalancer)') {
      steps {
        sh '''
          set -eux
          LB=$(kubectl -n camp-travel get svc frontend -o jsonpath='{.status.loadBalancer.ingress[0].hostname}{.status.loadBalancer.ingress[0].ip}')
          echo "Frontend LB: $LB"
          # Basic checks
          curl -sfI --max-time 10 "http://$LB/"
          curl -sfI --max-time 10 "http://$LB/api/health" || true
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'COMMIT.sha', onlyIfSuccessful: false
    }
  }
}
