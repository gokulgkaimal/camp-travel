pipeline {
  agent any
  options { timestamps() }

  environment {
    AWS_REGION   = 'ap-south-1'
    ACCOUNT_ID   = '338320348680'
    ECR_BACKEND  = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/camp-travel-backend"
    ECR_FRONTEND = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/camp-travel-frontend"
  }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm
        sh '''
          set -eux
          echo "HEAD: $(git rev-parse --short HEAD || true)"

          # quick sanity
          test -f backend/requirements.txt
          sed -n '1,20p' backend/Dockerfile || true

          [ -f .dockerignore ] && { echo "--- .dockerignore ---"; sed -n '1,200p' .dockerignore; } || true
          [ -f backend/.dockerignore ] && { echo "--- backend/.dockerignore ---"; sed -n '1,200p' backend/.dockerignore; } || true
        '''
      }
    }

    stage('Build Images') {
      steps {
        sh '''
          set -eux
          docker build -t backend:local  -f backend/Dockerfile  backend
          docker build -t frontend:local -f frontend/Dockerfile frontend
        '''
      }
    }

   stage('SonarQube Analysis') {
  steps {
    withSonarQubeEnv('SonarQube') {
      sh '''
        set -eux

        # Show what Jenkins sees on the host
        echo "PWD     = $(pwd)"
        echo "WORKSPACE = ${WORKSPACE:-"(unset)"}"
        ls -la

        # Show what the container sees after the mount
        docker run --rm -v "$(pwd):/usr/src" -w /usr/src alpine \
          sh -c 'pwd; ls -la; echo "--- dirs ---"; find . -maxdepth 2 -type d | sort'

        # Run scanner; point sources at repo root to avoid path brittleness
        docker run --rm \
          -e SONAR_HOST_URL="${SONAR_HOST_URL}" \
          -e SONAR_TOKEN="${SONAR_AUTH_TOKEN}" \
          -v "$(pwd):/usr/src" -w /usr/src \
          sonarsource/sonar-scanner-cli:5 \
            -Dsonar.projectKey=camp-travel \
            -Dsonar.projectName=camp-travel \
            -Dsonar.sourceEncoding=UTF-8 \
            -Dsonar.sources=. \
            -Dsonar.exclusions="**/node_modules/**,**/build/**,**/dist/**,**/.venv/**,**/__pycache__/**,**/.scannerwork/**" \
            -Dsonar.javascript.lcov.reportPaths=frontend/coverage/lcov.info \
            -Dsonar.python.coverage.reportPaths=backend/coverage.xml
      '''
    }
  }
}


    stage('Trivy image scan (soft-fail)') {
      steps {
        sh '''
          set +e
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --no-progress backend:local || true
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --no-progress frontend:local || true
          true
        '''
      }
    }

    stage('Login, tag & push to ECR') {
      steps {
        sh '''
          set -eux
          aws ecr get-login-password --region "$AWS_REGION" \
            | docker login --username AWS --password-stdin "$ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"

          COMMIT="$(git rev-parse --short HEAD || echo manual)"
          echo "$COMMIT" > COMMIT.sha
          echo "COMMIT=$COMMIT" > env.out

          docker tag backend:local  "$ECR_BACKEND:latest"
          docker tag backend:local  "$ECR_BACKEND:$COMMIT"
          docker tag frontend:local "$ECR_FRONTEND:latest"
          docker tag frontend:local "$ECR_FRONTEND:$COMMIT"

          docker push "$ECR_BACKEND:$COMMIT"
          docker push "$ECR_BACKEND:latest"
          docker push "$ECR_FRONTEND:$COMMIT"
          docker push "$ECR_FRONTEND:latest"
        '''
      }
    }

    stage('Deploy to EKS') {
      steps {
        sh '''
          set -eux
          aws eks update-kubeconfig --region "$AWS_REGION" --name camp-travel-eks

          [ -f env.out ] && . ./env.out || true

          kubectl get ns camp-travel || kubectl create ns camp-travel

          kubectl -n camp-travel apply -f k8s/backend-deployment.yaml
          kubectl -n camp-travel apply -f k8s/frontend-deployment.yaml

          kubectl -n camp-travel set image deploy/backend  backend="$ECR_BACKEND:${COMMIT}"
          kubectl -n camp-travel set image deploy/frontend frontend="$ECR_FRONTEND:${COMMIT}"

          kubectl -n camp-travel rollout status deploy/backend  --timeout=180s
          kubectl -n camp-travel rollout status deploy/frontend --timeout=180s
        '''
      }
    }

    stage('Smoke Test (Service LoadBalancer)') {
      steps {
        sh '''
          set -eux

          # wait up to ~2min for LB to attach an address
          for i in $(seq 1 24); do
            LB="$(kubectl -n camp-travel get svc frontend -o jsonpath='{.status.loadBalancer.ingress[0].hostname}{.status.loadBalancer.ingress[0].ip}' || true)"
            [ -n "$LB" ] && break
            sleep 5
          done
          echo "Frontend LB: ${LB:-<not-ready>}"

          # soft-fail both curls to avoid breaking the pipeline on 404/empty LB
          [ -n "$LB" ] && curl -sfI --max-time 10 "http://$LB/" || true
          [ -n "$LB" ] && curl -sfI --max-time 10 "http://$LB/api/health" || true
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'COMMIT.sha', onlyIfSuccessful: false
    }
  }
}
